<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Krox Design System Colors -->
    <color name="krox_obsidian_black">#08080A</color>
    <color name="krox_metallic_charcoal">#121216</color>
    <color name="krox_elevated_metallic_charcoal">#24242C</color>
    <color name="krox_crimson_red">#DC2626</color>

    <!-- Material3 Theme Attributes -->
    <style name="Theme.ZalithLauncher" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Krox Branding -->
        <item name="colorPrimary">@color/krox_crimson_red</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">#FFFFDAD6</item>
        <item name="colorOnPrimaryContainer">#6D000B</item>
        <item name="colorSecondary">#DC2626</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorSecondaryContainer">#FFFFDAD6</item>
        <item name="colorOnSecondaryContainer">#6D000B</item>
        <item name="colorTertiary">#DC2626</item>
        <item name="colorOnTertiary">#FFFFFFFF</item>
        <item name="colorTertiaryContainer">#FFFFDAD6</item>
        <item name="colorOnTertiaryContainer">#6D000B</item>

        <!-- Krox Surface Colors -->
        <item name="android:colorBackground">@color/krox_obsidian_black</item>
        <item name="colorSurface">@color/krox_metallic_charcoal</item>
        <item name="colorSurfaceVariant">@color/krox_elevated_metallic_charcoal</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorOnSurfaceVariant">#48484A</item>

        <!-- Elevated Surface -->
        <item name="colorSurfaceHigh">@color/krox_elevated_metallic_charcoal</item>

        <!-- Error Color -->
        <item name="colorError">#BA1A1A</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFFFDAD6</item>
        <item name="colorOnErrorContainer">#410002</item>
    </style>

    <style name="AppTheme.SplashScreen" parent="@style/Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.ZalithLauncher</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_launcher</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
